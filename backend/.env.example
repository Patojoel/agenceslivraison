POSTGRES_USER=delivery
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=delivery

# Set a random secret of at least 32 bytes to enable login.
JWT_SECRET=

# Requests a minute and per address. Defaults: 120 for ordinary routes, 60 for the public directory.
# In production these may be lowered, never raised (the API refuses to start above the defaults).
# RATE_LIMIT_DEFAULT_PER_MINUTE=120
# RATE_LIMIT_PUBLIC_PER_MINUTE=60
