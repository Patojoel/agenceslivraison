{
  "name": "agenceslivraison-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "migrate": "node dist/migrate.js",
    "test": "node --import tsx --test \"src/**/*.spec.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "node test/e2e.cjs",
    "lint": "eslint src test --max-warnings=0",
    "migration:generate": "npm run build && typeorm migration:generate -p -d dist/config/typeorm-cli.config.js",
    "migration:check": "npm run build && typeorm migration:generate --check -d dist/config/typeorm-cli.config.js src/migrations/schema-drift"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "argon2": "^0.45.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "eslint": "^10.14.0",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "multer": "^2.5.0",
    "js-yaml": "^5.5.0",
    "glob": "^14.0.3"
  }
}
